{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlife.local/schemas/events.json",
  "title": "OpenLife declarative events",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "seasons": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "months": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "fx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health": { "type": "number" },
        "heart": { "type": "number" },
        "energy": { "type": "number" },
        "money": { "type": "number" },
        "kpi": { "type": "number" },
        "credit": { "type": "number" },
        "smarts": { "type": "number" },
        "social": { "type": "number" },
        "child": { "type": "number" },
        "trait": { "type": "string" },
        "rel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": { "type": "number" },
            "friend": { "type": "number" },
            "love": { "type": "number" },
            "boss": { "type": "number" }
          }
        },
        "flags": { "type": "object", "additionalProperties": true }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minMoney": { "type": "number" },
        "maxHealth": { "type": "number" },
        "minRel": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "parentsAlive": { "type": "boolean" },
        "flag": { "type": "string" },
        "noFlag": { "type": "string" },
        "childAgeMin": { "type": "number" },
        "childAgeMax": { "type": "number" },
        "careerTrack": { "enum": ["corporate", "multinational", "sme", "factory"] },
        "district": { "type": "string" }
      }
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stat": { "enum": ["health", "heart", "energy", "money", "kpi", "credit", "smarts", "social"] },
        "delta": { "type": "number" },
        "rel": { "enum": ["family", "friend", "love", "boss"] },
        "flag": { "type": "string" },
        "value": { "type": ["boolean", "number", "string"] },
        "salarySet": { "type": "number" },
        "salaryMul": { "type": "number" },
        "salaryAtLeast": { "type": "number" },
        "rent": { "type": "number" },
        "job": { "type": "string" },
        "jobAppend": { "type": "string" },
        "debt": { "type": "string" },
        "add": { "type": "number" },
        "set": { "type": "number" },
        "zero": { "type": "boolean" },
        "reserve": { "type": "number" },
        "shiftTo": { "type": "string" },
        "ifFlag": { "type": "string" },
        "then": { "type": "array", "items": { "$ref": "#/$defs/op" } },
        "else": { "type": "array", "items": { "$ref": "#/$defs/op" } },
        "toast": { "type": "string" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "fx": { "$ref": "#/$defs/fx" },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } },
        "toast": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "fx": { "$ref": "#/$defs/fx" },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } },
        "random": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/branch" }
        },
        "hint": { "type": "array" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "title", "text", "choices"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "month": { "type": "integer", "minimum": 0, "maximum": 11 },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "requires": { "$ref": "#/$defs/requires" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/choice" }
        }
      }
    }
  }
}
